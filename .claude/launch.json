{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 3000
    },
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "backend", "run", "start:dev"],
      "port": 3001
    },
    {
      "name": "ai-service",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd ai-service && venv/bin/uvicorn app.main:app --port 8000"],
      "port": 8000
    }
  ]
}
