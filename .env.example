# Supabase (Auth + Postgres client SDK)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>

# NestJS backend base URL — the frontend only ever talks to this
NEXT_PUBLIC_API_URL=http://localhost:3001

# DEV ONLY — renders every page as a fake logged-in user, skipping real
# Supabase auth entirely (see src/lib/auth/auth-context.tsx). Leave unset
# or "false" outside of local development.
NEXT_PUBLIC_BYPASS_AUTH=false
