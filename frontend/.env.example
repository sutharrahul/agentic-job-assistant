# NestJS backend. The frontend talks ONLY to this — never to the AI
# service directly (see the architecture rule in README.md).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Clerk — authentication.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_<clerk-publishable-key>
CLERK_SECRET_KEY=sk_test_<clerk-secret-key>

# This app uses /login and /signup rather than Clerk's default
# /sign-in and /sign-up, so Clerk has to be told where they live —
# otherwise its redirects and the links between the two forms 404.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup

# Where to land after authenticating. Resume first: nearly every AI
# action needs a confirmed resume, so sending people anywhere else just
# bounces them back here.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/resume
