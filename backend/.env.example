# Server
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database — Supabase Postgres connection string, used by Prisma
DATABASE_URL=postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres

# Supabase — used to verify auth JWTs and to upload/sign resume Storage URLs
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_SECRET=<supabase-jwt-secret>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
# Optional — defaults to "resumes" if unset (see supabase.service.ts)
SUPABASE_STORAGE_BUCKET=resumes

# Internal AI service (FastAPI) — never exposed to the frontend
AI_SERVICE_URL=http://localhost:8000

# DEV ONLY — mirrors frontend's NEXT_PUBLIC_BYPASS_AUTH, but this is a
# SEPARATE switch: both must be "true" for the bypass to work end to
# end (see auth/guards/supabase-auth.guard.ts). Leave unset or "false"
# outside of local development.
BYPASS_AUTH=false

# Redis (Upstash) — caching fit-analysis results (OrchestrationService)
# and API rate limiting
REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379
