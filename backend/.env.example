# Server
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database — Supabase Postgres, used by Prisma.
# Use the SESSION POOLER connection string, not the direct one: direct
# connections are IPv6-only and most hosts (Render's free tier included)
# can't reach them.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Clerk — authentication.
# CLERK_SECRET_KEY verifies incoming session JWTs (see clerk-auth.guard.ts).
# NOTE: the guard reads an `email` claim that is NOT in Clerk's default
# session token — add it in the dashboard under
# Configure -> Sessions -> Customize session token:
#   { "email": "{{user.primary_email_address}}" }
CLERK_SECRET_KEY=sk_test_<clerk-secret-key>
# From the Clerk dashboard's Webhooks page, per endpoint. Verifies the
# user.created/user.updated payloads (see webhooks/clerk-webhook.controller.ts).
CLERK_WEBHOOK_SIGNING_SECRET=whsec_<clerk-webhook-signing-secret>

# Supabase — storage only (resume files). Auth is Clerk's job.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
# Optional — defaults to "resumes" if unset (see supabase.service.ts)
SUPABASE_STORAGE_BUCKET=resumes

# Internal AI service (FastAPI) — never exposed to the frontend.
# No trailing slash: OrchestrationService concatenates the path onto this.
AI_SERVICE_URL=http://localhost:8000
# Shared secret sent as X-Service-Token on every AI call. Optional locally
# (leave unset and the AI service accepts anything), required in any
# deployment where that service has a public URL — which is the case on
# free tiers with no private networking. Must match SERVICE_TOKEN in
# ai-service/.env; render.yaml wires both sides to one generated value.
# AI_SERVICE_TOKEN=
