# Which LLM backs every chat call in this service (see app/core/llm.py).
#   ollama     — free and local, good for day-to-day dev
#   gemini     — Google AI Studio
#   openrouter — one gateway in front of many models, incl. free ones
# Switching is an env change only, no code change.
LLM_PROVIDER=ollama

# Required only when LLM_PROVIDER=gemini
GEMINI_API_KEY=<gemini-api-key>

# Optional. Defaults to the moving "gemini-flash-latest" alias; set a
# dated id here (e.g. gemini-2.5-flash) to pin the model.
# GEMINI_CHAT_MODEL=

# Required only when LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=<openrouter-api-key>

# Optional — defaults to google/gemma-4-31b-it:free (verified to support
# tool calling).
# WARNING: three of the four endpoints use structured output, so the
# model MUST list "tools" under supported_parameters. Many of
# OpenRouter's free models do NOT. Check before changing:
#   curl -s https://openrouter.ai/api/v1/models
# Avoid "openrouter/free" — it picks a random model per request, which
# breaks the determinism that temperature=0 fit scoring depends on.
# OPENROUTER_CHAT_MODEL=google/gemma-4-31b-it:free

# Used only when LLM_PROVIDER=ollama. Requires Ollama running locally
# (https://ollama.com) with these models pulled:
#   ollama pull gemma3:4b
#   ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=gemma3:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
