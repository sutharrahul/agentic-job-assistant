# Which LLM backs every chat call in this service (see app/core/llm.py).
#   ollama — free and local, good for day-to-day dev
#   gemini — Google AI Studio, used in production
# Switching is an env change only, no code change.
LLM_PROVIDER=ollama

# Required only when LLM_PROVIDER=gemini
GEMINI_API_KEY=<gemini-api-key>

# Optional. Defaults to gemini-3.5-flash-lite — the lightest Gemini tier,
# picked for its higher free-tier request quota (resume extraction fires
# three concurrent calls per upload). Override to pin a different model.
# GEMINI_CHAT_MODEL=

# Used only when LLM_PROVIDER=ollama. Requires Ollama running locally
# (https://ollama.com) with these models pulled:
#   ollama pull gemma3:4b
#   ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=gemma3:4b

# Shared secret NestJS must send as X-Service-Token (see
# app/core/security.py). Leave unset locally — the service then accepts
# any caller, which is what you want on localhost. REQUIRED on any public
# deployment: this service has no other authentication, and its endpoints
# spend paid LLM quota. render.yaml generates one and hands the same value
# to both services.
# SERVICE_TOKEN=
