# Which LLM backs every chat/embeddings call in this service (see
# app/core/llm.py). "ollama" is free and local — use it for day-to-day
# dev/testing so you don't burn Gemini quota. Switch to "gemini" here
# (no code change) once you want the real model.
LLM_PROVIDER=ollama

# Required only when LLM_PROVIDER=gemini
GEMINI_API_KEY=<gemini-api-key>

# Optional. Defaults to the moving "gemini-flash-latest" alias; set a
# dated id here (e.g. gemini-2.5-flash) to pin the model.
# GEMINI_CHAT_MODEL=

# Used only when LLM_PROVIDER=ollama. Requires Ollama running locally
# (https://ollama.com) with these models pulled:
#   ollama pull gemma3:4b
#   ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=gemma3:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
